{
  "name": "taskline",
  "version": "1.0.0",
  "description": "Global task capture and local Kanban for T3 Code",
  "private": true,
  "type": "module",
  "main": "build/electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node build/server/index.js",
    "start": "tsx scripts/launch.ts",
    "build": "npm run typecheck && npm run build:runtime && vite build",
    "package": "npm run build && electron-builder --mac dir && tsx scripts/sign-mac.ts",
    "test": "npm run build:runtime && tsx scripts/test-unit.ts",
    "test:e2e": "playwright test",
    "test:live": "tsx scripts/live-e2e.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist:mac": "npm run build && tsx scripts/dist.ts mac",
    "dist:win": "npm run build && tsx scripts/dist.ts win",
    "test:unit": "npm test",
    "typecheck": "tsc --noEmit",
    "build:runtime": "tsx scripts/build.ts",
    "check:release": "tsx scripts/check-release.ts",
    "install:cli": "npm run build:runtime && node build/scripts/install-cli.js",
    "check:sources": "tsx scripts/check-sources.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cross-spawn": "7.0.6",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.qisoft.taskline",
    "productName": "Taskline",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/server/**/*",
      "build/electron/**/*",
      "build/shared/**/*",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Dictate a task prompt.",
        "NSSpeechRecognitionUsageDescription": "Turn dictated tasks into text."
      },
      "icon": "assets/taskline.icns",
      "artifactName": "Taskline-${version}-macos-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "build/standalone/taskline.mjs",
        "to": "taskline.mjs"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/taskline.png",
      "artifactName": "Taskline-${version}-windows-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true
    },
    "publish": null
  },
  "author": "qisoft",
  "bin": {
    "taskline": "build/standalone/taskline.mjs"
  },
  "license": "MIT",
  "homepage": "https://github.com/qisoft/taskline",
  "repository": {
    "type": "git",
    "url": "https://github.com/qisoft/taskline.git"
  },
  "bugs": {
    "url": "https://github.com/qisoft/taskline/issues"
  },
  "engines": {
    "node": ">=24"
  }
}
