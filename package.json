{
  "name": "taskline",
  "version": "1.0.0",
  "description": "Global task capture and local Kanban for T3 Code",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node server/index.mjs",
    "start": "node scripts/launch.mjs",
    "build": "vite build",
    "package": "npm run build && electron-builder --mac dir && node scripts/sign-mac.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:live": "node scripts/live-e2e.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "electron": "44.7.0",
    "electron-builder": "latest",
    "prettier": "^3.9.10",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "com.qisoft.taskline",
    "productName": "Taskline",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "hardenedRuntime": false,
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Dictate a task prompt.",
        "NSSpeechRecognitionUsageDescription": "Turn dictated tasks into text."
      },
      "icon": "assets/taskline.icns"
    },
    "extraResources": [
      {
        "from": "cli/taskline.mjs",
        "to": "taskline.mjs"
      }
    ]
  },
  "author": "qisoft",
  "bin": {
    "taskline": "cli/taskline.mjs"
  }
}
