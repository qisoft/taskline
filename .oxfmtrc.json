{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "release/",
    "artifacts/",
    "playwright-report/",
    "test-results/",
    ".data/",
    "package-lock.json",
    "build/"
  ]
}
